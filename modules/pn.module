pnall() {
  SESSION="pn"
  pnedit "$SESSION"
  pnsupport "$SESSION"
  tmux select-window -t "$SESSION:pn edit"
}

pnedit() {
  local SESSION="$1"
  local DIR="/home/miguel/DEV/PN/eternal-sledgehammer"

  tmux new-window -t "$SESSION" -n 'pn edit' -c "$DIR"

  tmux split-window -t "$SESSION:pn edit".0 -v -p 20 -c "$DIR"
  tmux split-window -t "$SESSION:pn edit".0 -h -p 45 -c "$DIR"

  tmux send-keys -t "$SESSION:pn edit".0 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn edit".0 'load_dotenv; lg' Enter

  tmux send-keys -t "$SESSION:pn edit".2 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn edit".2 'load_dotenv' Enter

  tmux send-keys -t "$SESSION:pn edit".1 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn edit".1 'load_dotenv' Enter
}

pnsupport() {
  local SESSION="$1"
  local DIR="/home/miguel/DEV/PN/eternal-sledgehammer"

  tmux new-window -t "$SESSION" -n 'pn support' -c "$DIR"

  tmux split-window -t "$SESSION:pn support".0 -h -p 50 -c "$DIR"
  tmux split-window -t "$SESSION:pn support".1 -v -p 80 -c "$DIR"
  tmux split-window -t "$SESSION:pn support".2 -v -p 70 -c "$DIR"

  tmux send-keys -t "$SESSION:pn support".1 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn support".1 'load_dotenv; pn_vite' Enter

  tmux send-keys -t "$SESSION:pn support".2 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn support".2 'load_dotenv; pn_sidekiq' Enter

  tmux send-keys -t "$SESSION:pn support".3 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn support".3 'load_dotenv; pn_server' Enter

  tmux send-keys -t "$SESSION:pn support".0 'pndev shell' Enter
  tmux send-keys -t "$SESSION:pn support".0 'load_dotenv' Enter
}

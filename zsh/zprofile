# ~/.zprofile -> ~/.dotfiles/zsh/zprofile  (zsh LOGIN shells, after /etc/zsh/zprofile)
# Environment variables moved to ~/.dotfiles/zsh/env.sh (sourced by ~/.zshenv)
# so non-login shells get them too.

# /etc/zsh/zprofile -> /etc/profile (+ nix-daemon.sh) may prepend to PATH; put
# mise shims and the dotfiles' own dirs back in front (dupes are dropped).
typeset -gU path
[[ -r $HOME/.dotfiles/zsh/env.sh ]] && source $HOME/.dotfiles/zsh/env.sh
path=($path)

### ssh-agent ###
# Deliberately not started here. keychain (below) finds-or-starts a single agent
# and caches its socket in ~/.keychain so every login reuses the same one.

### keychain (interactive logins with a TTY only; asks for key passphrases
### once per boot, until the agent holds the keys)
# keychain 3: --immediate restores the 2.x behaviour (ask for the passphrase
# right away, no "Press Enter to run ssh-add" wait). Ctrl-C at the prompt skips
# key loading only: the INT trap stops zsh from aborting the rest of startup
# (zshrc, prompt, herdr); the agent env then comes from ~/.keychain.
if [[ -o interactive && -t 0 ]] && (( $+commands[keychain] )); then
  _keychain_load() {
    setopt localoptions localtraps
    trap : INT
    eval "$(keychain add --eval --quiet --immediate id_rsa github id_rsa_main)"
    [[ -S $SSH_AUTH_SOCK ]] || { [[ -r ~/.keychain/$HOST-sh ]] && source ~/.keychain/$HOST-sh >/dev/null }
  }
  _keychain_load
  unfunction _keychain_load
fi

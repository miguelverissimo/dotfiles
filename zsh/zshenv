# ~/.zshenv -> ~/.dotfiles/zsh/zshenv
# Read by EVERY zsh (incl. `ssh nuc 'cmd'`, scp, rsync). Env only; keep it
# quiet and fast. Interactive things (aliases, prompt, herdr) live in ~/.zshrc.

# No duplicate entries in the path arrays.
typeset -gU path fpath cdpath manpath

[[ -r $HOME/.dotfiles/zsh/env.sh ]] && source $HOME/.dotfiles/zsh/env.sh
path=($path)   # re-assign the array so typeset -U drops duplicates

